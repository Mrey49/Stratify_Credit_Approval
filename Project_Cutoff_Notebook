    "    bars = axes[i].bar(counts_s.index.astype(str), counts_s.values, color=NAVY)\n",
    "    axes[i].set_title(col, fontsize=9)\n",
    "    axes[i].tick_params(axis='x', labelsize=7, rotation=45)\n",
    "    axes[i].tick_params(axis='y', labelsize=7)\n",
    "    total = counts_s.sum()\n",
    "    for b, v in zip(bars, counts_s.values):\n",
    "        axes[i].text(b.get_x()+b.get_width()/2, v, f'{v/total*100:.0f}%', ha='center', va='bottom', fontsize=6.5)\n",

    "def segment_of(row):\n",
    "    if row.old_approved and row.new_approved:   return 'Approved by both'\n",
    "    if row.old_approved and not row.new_approved: return 'Old only (Newly Rejected)'\n",
    "    if not row.old_approved and row.new_approved: return 'New only (Newly Approved)'\n",
    "    return 'Rejected by both'\n",
    "\n",
    "df['segment'] = df.apply(segment_of, axis=1)\n",
    "\n",
    "SEGMENT_ORDER = ['New only (Newly Approved)', 'Old only (Newly Rejected)', 'Approved by both', 'Rejected by both']\n",
    "SEGMENT_COLORS = {'New only (Newly Approved)': GREEN, 'Old only (Newly Rejected)': RED,\n",
    "                   'Approved by both': NAVY, 'Rejected by both': GREY}\n",
    "\n",
    "counts = df['segment'].value_counts().reindex(SEGMENT_ORDER)\n",
    "default_rates = df.groupby('segment')['defaulted'].mean().reindex(SEGMENT_ORDER) * 100\n",
    "\n",
    "summary = pd.DataFrame({'applicants': counts, 'default_rate_%': default_rates.round(2)})\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 4.3))\n",
    "wedges, _, autotexts = ax1.pie(counts, labels=None, autopct='%1.1f%%', startangle=90,\n",
    "       colors=[SEGMENT_COLORS[s] for s in SEGMENT_ORDER],\n",
    "       wedgeprops=dict(width=0.42, edgecolor='white'), pctdistance=0.79)\n",
    "for t in autotexts: t.set_color('white'); t.set_fontweight('bold'); t.set_fontsize=8\n",
    "ax1.set_title('Applicants by segment (45,000 total)', fontsize=11)\n",
    "ax1.legend(SEGMENT_ORDER, loc='center', bbox_to_anchor=(0.5, 0.5), frameon=False, fontsize=7.5)\n",
    "\n",
    "bars = ax2.bar(SEGMENT_ORDER, default_rates, color=[SEGMENT_COLORS[s] for s in SEGMENT_ORDER])\n",
    "ax2.axhline(6.5, color='black', linestyle='--', linewidth=1, label='6.5% mandate cap')\n",
    "ax2.set_ylabel('Default rate (%)')\n",
    "ax2.set_title('Default rate by segment', fontsize=11)\n",
    "ax2.set_xticklabels(SEGMENT_ORDER, rotation=25, ha='right', fontsize=8)\n",
    "ax2.legend(fontsize=8)\n",
    "for b, v in zip(bars, default_rates):\n",

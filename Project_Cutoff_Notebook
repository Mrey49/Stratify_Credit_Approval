   "source": [
    "PROFIT_PER_GOOD_LOAN = 6400   # Rs, per Cutoff_Report_2.ipynb Section 5\n",
    "LOSS_PER_BAD_LOAN    = 52000  # Rs, per Cutoff_Report_2.ipynb Section 5\n",
    "\n",
    "def segment_economics(g):\n",
    "    good = int((g.defaulted == 0).sum())\n",
    "    bad  = int((g.defaulted == 1).sum())\n",
    "    profit = good * PROFIT_PER_GOOD_LOAN - bad * LOSS_PER_BAD_LOAN\n",
    "    return pd.Series({'applicants': len(g), 'good loans': good, 'defaults': bad,\n",
    "                       'net profit (Rs)': profit, 'profit per applicant (Rs)': profit / len(g)})\n",
    "\n",
    "econ = df.groupby('segment').apply(segment_economics, include_groups=False).reindex(SEGMENT_ORDER)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8.5, 4.3))\n",
    "colors = [GREEN if v >= 0 else RED for v in econ['net profit (Rs)']]\n",
    "bars = ax.barh(econ.index, econ['net profit (Rs)']/1e6, color=colors)\n",
    "ax.axvline(0, color='black', linewidth=0.8)\n",
    "ax.set_xlabel('Net profit if this segment is approved (Rs, millions)')\n",
    "ax.set_title('What each segment is actually worth')\n",
    "for b, v in zip(bars, econ['net profit (Rs)']):\n",
    "    ax.text(v/1e6 + (0.5 if v >= 0 else -0.5), b.get_y()+b.get_height()/2, f'Rs {v/1e6:,.1f}M',\n",

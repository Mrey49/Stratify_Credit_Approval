   "source": [
    "PROFIT_PER_GOOD_LOAN = 6400   # Rs, per the brief \u2014 derivation shown in Section 5\n",
    "LOSS_PER_BAD_LOAN    = 52000  # Rs, per the brief \u2014 derivation shown in Section 5\n",
    "\n",
    "def build_diagnosis(mask_dict):\n",
    "    rows = []\n",
    "    for name, hit in mask_dict.items():\n",
    "        rejected      = int(hit.sum())\n",
    "        would_repay   = int((hit & (df.defaulted == 0)).sum())\n",
    "        would_default = rejected - would_repay\n",
    "        foregone_profit = would_repay * PROFIT_PER_GOOD_LOAN\n",
    "        avoided_loss    = would_default * LOSS_PER_BAD_LOAN\n",
    "        rows.append({\n",
    "            'rule'                    : name,\n",
    "            'rejected'                : rejected,\n",
    "            '% of all applicants'     : round(100*rejected/len(df), 1) if rejected else 0,\n",
    "            'would have repaid'       : would_repay,\n",
    "            'would-repay rate'        : round(100*would_repay/rejected, 1) if rejected else 0,\n",
    "            'foregone profit (Rs)'    : foregone_profit,\n",
    "            'avoided loss (Rs)'       : avoided_loss,\n",
    "            'net impact (Rs)'         : avoided_loss - foregone_profit,\n",
    "        })\n",
    "    return pd.DataFrame(rows).sort_values('net impact (Rs)').reset_index(drop=True)\n",
    "\n",
    "diagnosis = build_diagnosis({name: rules[name] for name in rules.columns})\n",
    "diagnosis.style.format({\n",
    "    'rejected': '{:,.0f}', 'would have repaid': '{:,.0f}',\n",
    "    'foregone profit (Rs)': '{:,.0f}', 'avoided loss (Rs)': '{:,.0f}', 'net impact (Rs)': '{:,.0f}',\n",
    "})\n"

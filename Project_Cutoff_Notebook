    "rules['R2'] = df.months_in_current_job < 12\n",
    "rules['R3'] = df.loan_to_income_ratio > 6\n",
    "rules['R4'] = df.emi_to_income_ratio > 0.45\n",
    "rules['R5'] = df.age < 23\n",
    "rules['R6'] = df.bureau_overdue_amount > 0\n",
    "rules['R7'] = df.enquiries_last_quarter > 4\n",
    "rules['R8'] = df.occupation_type.isna() | (df.occupation_type.astype(str).str.strip() == '')\n",
    "df['old_approved'] = ~rules.any(axis=1)\n",
    "\n",
    "# --- New policy: safest 59% by risk_score (the recommended cutoff from Cutoff_Report_2.ipynb) ---\n",
    "APPROVAL_RATE = 0.59\n",

    "gap_rows = []\n",
    "for col, tab in categorical_breakdowns.items():\n",
    "    for cat_value in tab.index:\n",
    "        new_pct = tab.loc[cat_value, 'New only (Newly Approved)']\n",
    "        old_pct = tab.loc[cat_value, 'Old only (Newly Rejected)']\n",
    "        gap_rows.append({\n",
    "            'column': col,\n",
    "            'category': cat_value,\n",
    "            'New only %': new_pct,\n",
    "            'Old only %': old_pct,\n",
    "            'gap_pp': round(new_pct - old_pct, 1),\n",
    "        })\n",
    "\n",
    "gap_df = pd.DataFrame(gap_rows)\n",
    "gap_df['abs_gap'] = gap_df['gap_pp'].abs()\n",
    "top_gaps = gap_df.sort_values('abs_gap', ascending=False).head(15).drop(columns='abs_gap').reset_index(drop=True)\n",
    "\n",
    "def color_gap(val):\n",
    "    if isinstance(val, (int, float)):\n",

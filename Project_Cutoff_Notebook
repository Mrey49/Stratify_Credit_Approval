    "d = df.sort_values('risk_score').reset_index(drop=True)   # safest applicants first\n",
    "\n",
    "sweep_rows = []\n",
    "for pct in range(1, 101):\n",
    "    k = int(pct/100 * len(d))\n",
    "    approved = d.iloc[:k]\n",
    "    bad  = int(approved.defaulted.sum())\n",
    "    good = k - bad\n",
    "    profit = good*PROFIT_PER_GOOD_LOAN - bad*LOSS_PER_BAD_LOAN\n",
    "    default_rate = 100*bad/k\n",
    "\n",
    "    sweep_rows.append({\n",
    "        'approval_rate_%'     : pct,\n",
    "        'applicants_approved' : k,\n",
    "        'defaults'            : bad,\n",
    "        'default_rate_%'      : round(default_rate, 2),\n",
    "        'meets_6.5%_cap'      : default_rate <= 6.5,\n",
    "        'profit_total (Rs)'   : profit,\n",
    "        'profit_per_10k_apps (Rs)': profit/len(d)*10000,\n",
    "    })\n",
    "\n",
    "sweep = pd.DataFrame(sweep_rows)\n",
    "sweep.iloc[::10]   # a readable preview every 10 points\n"

    "# Independent validation against meridian_column_statistics.xlsx\n",
    "ref_stats = pd.read_excel('meridian_column_statistics.xlsx').set_index('Column Name')\n",
    "\n",
    "check_rows = []\n",
    "for col in ref_stats.index:\n",
    "    if col not in df.columns:\n",
    "        continue\n",
    "    actual_min, actual_max, actual_mean = df[col].min(), df[col].max(), df[col].mean()\n",
    "    ref_min, ref_max, ref_mean = ref_stats.loc[col, ['Min', 'Max', 'Mean']]\n",
    "    mean_pct_err = abs(actual_mean - ref_mean) / (abs(ref_mean) if ref_mean else 1) * 100\n",
    "    check_rows.append({\n",
    "        'column': col,\n",
    "        'min (data)': actual_min, 'min (reference)': ref_min,\n",
    "        'max (data)': actual_max, 'max (reference)': ref_max,\n",
    "        'mean (data)': round(actual_mean, 4), 'mean (reference)': round(ref_mean, 4),\n",
    "        'mean_%_error': round(mean_pct_err, 4),\n",
    "        'match': 'OK' if (actual_min == ref_min and actual_max == ref_max and mean_pct_err < 0.01) else 'CHECK',\n",
    "    })\n",
    "\n",
    "validation = pd.DataFrame(check_rows).set_index('column')\n",
    "n_ok = (validation['match'] == 'OK').sum()\n",
    "print(f'{n_ok} / {len(validation)} columns match meridian_column_statistics.xlsx exactly (min, max, mean).')\n",
    "\n",
    "def flag_match(val):\n",
    "    return f'background-color: {\"#c6efce\" if val == \"OK\" else \"#fce4e4\"}; font-weight: bold'\n",
    "\n",
    "validation.style.map(flag_match, subset=['match']).format({\n",
    "    'min (data)': '{:,.3f}', 'min (reference)': '{:,.3f}',\n",
    "    'max (data)': '{:,.3f}', 'max (reference)': '{:,.3f}',\n",
    "    'mean (data)': '{:,.3f}', 'mean (reference)': '{:,.3f}',\n",
    "    'mean_%_error': '{:.4f}%',\n",
    "})"
   ]

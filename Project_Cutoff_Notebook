   "source": [
    "# Find the zone from the DATA: where does cumulative profit actually peak?\n",
    "# (not simply where the default-rate cap gets breached \u2014 those can be very different points)\n",
    "peak_band = int(band.loc[band['cumulative_profit_per_10k_apps (Rs)'].idxmax(), 'risk_band'])\n",
    "peak_row  = band[band.risk_band == peak_band].iloc[0]\n",
    "\n",
    "cap_breach = band[band['cumulative_default_rate_%'] > 6.5]\n",
    "first_breach_band = int(cap_breach['risk_band'].min()) if len(cap_breach) else None\n",
    "\n",
    "print('Band where cumulative profit peaks       : Band {} (cumulative approval {}%, default rate {}%, profit/10k Rs {:,.0f})'.format(\n",
    "    peak_band, peak_row['cumulative_approval_%'], peak_row['cumulative_default_rate_%'], peak_row['cumulative_profit_per_10k_apps (Rs)']))\n",
    "if first_breach_band:\n",
    "    breach_row = band[band.risk_band == first_breach_band].iloc[0]\n",
    "    print('Band where the 6.5% cap is first breached : Band {} (cumulative approval {}%, default rate {}%)'.format(\n",
    "        first_breach_band, breach_row['cumulative_approval_%'], breach_row['cumulative_default_rate_%']))\n",

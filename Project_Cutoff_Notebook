   "source": [
    "df['risk_band'] = pd.qcut(df.risk_score, 20, labels=range(1, 21))\n",
    "\n",
    "band = df.groupby('risk_band', observed=True).agg(\n",
    "    applicants=('defaulted', 'size'),\n",
    "    defaults=('defaulted', 'sum'),\n",
    ").reset_index()\n",
    "band['risk_band'] = band['risk_band'].astype(int)\n",
    "band = band.sort_values('risk_band').reset_index(drop=True)\n",
    "\n",
    "band['band_default_rate_%']       = round(100*band['defaults']/band['applicants'], 1)\n",
    "band['cumulative_approval_%']     = band['risk_band'] * 5\n",
    "band['cumulative_applicants']     = band['applicants'].cumsum()\n",
    "band['cumulative_defaults']       = band['defaults'].cumsum()\n",
    "band['cumulative_default_rate_%'] = round(100*band['cumulative_defaults']/band['cumulative_applicants'], 2)\n",
    "\n",
    "cumulative_good   = band['cumulative_applicants'] - band['cumulative_defaults']\n",
    "cumulative_profit = cumulative_good*PROFIT_PER_GOOD_LOAN - band['cumulative_defaults']*LOSS_PER_BAD_LOAN\n",
    "band['cumulative_profit_per_10k_apps (Rs)'] = round(cumulative_profit/len(df)*10000)\n",
    "\n",
    "band_display = band[['risk_band','cumulative_approval_%','band_default_rate_%',\n",
    "                      'cumulative_default_rate_%','cumulative_profit_per_10k_apps (Rs)']]\n",
    "band_display\n"
   ]

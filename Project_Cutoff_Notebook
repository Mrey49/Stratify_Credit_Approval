    "           'num_trade_lines', 'existing_loan_count', 'has_credit_card']\n",
    "\n",
    "vc_check_rows = []\n",
    "for col in VC_COLS:\n",
    "    ref_counts = vc_ref[[col, col + '_Count']].dropna().set_index(col)[col + '_Count'].astype(int)\n",
    "    actual_counts = df[col].value_counts()\n",
    "    # align index types (mixed int/str columns read back as float from excel in some cases)\n",
    "    ref_counts.index = ref_counts.index.map(lambda x: x if isinstance(x, str) else (int(x) if float(x).is_integer() else x))\n",
    "    actual_counts.index = actual_counts.index.map(lambda x: x if isinstance(x, str) else (int(x) if float(x).is_integer() else x))\n",
    "    match = ref_counts.sort_index().equals(actual_counts.sort_index())\n",
    "    vc_check_rows.append({\n",
    "        'column': col,\n",
    "        'categories (data)': len(actual_counts),\n",
    "        'categories (reference)': len(ref_counts),\n",
    "        'total records (data)': int(actual_counts.sum()),\n",
    "        'total records (reference)': int(ref_counts.sum()),\n",
    "        'match': 'OK' if match else 'CHECK',\n",
